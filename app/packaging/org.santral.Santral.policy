<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!--
  Santral için polkit policy. Hiçbir yeni eylem TANIMLAMAZ; sadece
  Santral'in pkexec ile root komut çalıştırma davranışını açıklayan
  bilgi amaçlı bir dosyadır.

  Santral'in çağırdığı tüm root komutlar (apt-get, dnf, pacman, zypper,
  systemctl, journalctl, vb.) zaten kendi paket yöneticilerinin polkit
  policy'lerini kullanır. pkexec için varsayılan
  org.freedesktop.policykit.exec eylemi `auth_admin_keep` ile gelir —
  bu da bir kez girilen parolanın oturum boyu (genellikle 5 dakika)
  bellekte tutulmasını sağlar.

  Eğer parolanın daha uzun süre cache'lenmesini istersen, sistemine
  bir rule ekleyebilirsin:

    /etc/polkit-1/rules.d/49-santral.rules:
    polkit.addRule(function(action, subject) {
      if (action.id == "org.freedesktop.policykit.exec" &&
          subject.isInGroup("wheel"))
      {
        return polkit.Result.AUTH_ADMIN_KEEP;
      }
    });
-->
<policyconfig>
  <vendor>Santral kollektifi</vendor>
  <vendor_url>https://github.com/reverx99/santral</vendor_url>
</policyconfig>
